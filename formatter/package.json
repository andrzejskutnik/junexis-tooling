{
    "name": "@junexislang/formatter",
    "version": "0.1.0",
    "description": "Code formatter for junexislang - opinionated, zero-config",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "watch": "tsc --watch",
        "test": "jest",
        "test:watch": "jest --watch",
        "clean": "rimraf dist"
    },
    "keywords": [
        "junexislang",
        "formatter",
        "prettier",
        "code-style"
    ],
    "author": "junexislang Team",
    "license": "MIT",
    "dependencies": {
        "@junexislang/parser": "file:../parser"
    },
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "@types/node": "^20.11.24",
        "jest": "^29.7.0",
        "rimraf": "^5.0.5",
        "ts-jest": "^29.1.2",
        "typescript": "^5.9.3"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/src"
        ],
        "testMatch": [
            "**/__tests__/**/*.test.ts"
        ]
    }
}